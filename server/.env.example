NODE_ENV=development
PORT=5000

# Database Connection String (PostgreSQL / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_crm_db?schema=public"

# JWT Authentication Secrets
JWT_SECRET="super-secret-access-token-key-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
FRONTEND_URL="http://localhost:3000"

# Cloudinary Integration (Optional for local upload fallback)
CLOUDINARY_CLOUD_NAME="demo_cloud"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="demo_secret"

# Firebase Admin SDK Credentials (Optional for live Firebase server token verification)
FIREBASE_PROJECT_ID="your-firebase-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-firebase-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
